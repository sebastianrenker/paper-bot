# Kopiere diese Datei nach .env und trage deine Keys ein.
# .env NIEMALS ins Git-Repo committen (steht in .gitignore).
#
# Solange keine Keys hinterlegt sind, laeuft alles im Paper-Modus - das ist Absicht.
# Auch MIT Keys wird nicht automatisch live gehandelt: dafuer ist zusaetzlich
# `mode: live` in config.yaml UND der manuelle Bestaetigungsflow noetig
# (python cli.py enable-live --market crypto).

# --- Krypto (ccxt, z. B. Binance) ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- US-Aktien (Alpaca) ---
# Paper:  https://paper-api.alpaca.markets
# Live:   https://api.alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Forex (OANDA v20) ---
# Demo:   https://api-fxpractice.oanda.com
# Live:   https://api-fxtrade.oanda.com
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com
